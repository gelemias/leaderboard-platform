{
  "name": "leaderboard-platform",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "deploy:check": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply leaderboard-platform-dev --local",
    "db:seed": "wrangler d1 execute leaderboard-platform-dev --local --file=./seed/development.sql",
    "db:inspect": "wrangler d1 execute leaderboard-platform-dev --local --command=\"SELECT name, type FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY type, name;\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^26.1.2",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "hono": "^4.12.33",
    "zod": "^4.4.3"
  }
}
